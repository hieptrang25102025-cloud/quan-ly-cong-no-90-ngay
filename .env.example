# ====================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO HỆ THỐNG QUẢN LÝ CÔNG NỢ 90 NGÀY
# ====================================================================

# 1. KẾT NỐI SUPABASE
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# 2. KHÓA BẢO MẬT CRON JOB TỰ ĐỘNG
CRON_SECRET=super-secret-cron-token-90days

# 3. DỊCH VỤ EMAIL TỔNG HỢP (CHỈ GỬI CHO BẠN - TÙY CHỌN)
# Đăng ký tài khoản miễn phí tại https://resend.com để lấy API key
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM=He Thong Cong No <onboarding@resend.dev>

# 4. MÚI GIỜ HỆ THỐNG
NEXT_PUBLIC_TIMEZONE=Asia/Ho_Chi_Minh
